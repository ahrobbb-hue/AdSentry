# ==========================================
# AdSentry Bot - Configuration Template
# ==========================================

# [DISCORD BOT CREDENTIALS]
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678 #example

# [SUPABASE DATABASE CREDENTIALS]
SUPABASE_URL=https://your_SUPABASE_URL_hear.supabase.co
SUPABASE_ANON_KEY=sb_publishable_**************
SUPABASE_SERVICE_ROLE_KEY=sb_secret_********************

# [CHANNELS]
# Channel where submitted ads appear for staff to review (Approve/Reject)
STAFF_REVIEW_CHANNEL_ID=123456789012345678 #example
# Public channel where approved announcements are published
ANNOUNCEMENT_CHANNEL_ID=123456789012345678 #example

# [ROLES & PERMISSIONS]
# Comma-separated role IDs allowed to approve/reject submissions
STAFF_ROLE_IDS=123456789012345678,234567890123456789

# [MODERATION & COOLDOWNS]
# Global cooldown period per user after submitting an ad (in hours)
COOLDOWN_HOURS=24
# Comma-separated words or domains filtered automatically
FORBIDDEN_WORDS=discord.gg/,t.me/,invite.gg/,@everyone,@here
# Interval in seconds to check for expired ads
EXPIRY_SWEEPER_INTERVAL=60

# [LOGGING]
LOG_LEVEL=INFO
